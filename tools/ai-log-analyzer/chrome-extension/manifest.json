{
  "manifest_version": 3,
  "name": "CI/CD Error Analyzer",
  "version": "0.1.0",
  "description": "Display AI-assisted Jenkins failure analysis.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:8080/*", "http://127.0.0.1:8080/*"],
      "js": ["content.js"]
    }
  ]
}
