extends: default

ignore: |
  **/target/**
  **/build/**
  **/tmp/**
  apis/*/*/src/main/wso2mi/resources/metadata/*.yaml
  apis/*/*/src/main/wso2mi/resources/api-definitions/*.yaml

rules:
  document-start:
    present: false

  indentation:
    spaces: 2
    indent-sequences: consistent

  brackets:
    max-spaces-inside: 1

  line-length:
    max: 120
    level: warning

  new-line-at-end-of-file:
    level: warning

  truthy:
    allowed-values: ['true', 'false']
    check-keys: false
