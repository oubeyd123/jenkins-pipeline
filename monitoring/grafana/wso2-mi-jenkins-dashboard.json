    {
      "id": 10,
      "type": "bargauge",
      "title": "Average Build Duration By Branch/Job",
      "description": "Average build duration in minutes. Long values usually come from Maven downloads, Trivy DB/cache, Docker image builds, or smoke-test retries.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(jenkins_jenkins_builds_duration_milliseconds_summary_sum{jenkins_job=~\"$jenkins_job\"} / jenkins_jenkins_builds_duration_milliseconds_summary_count{jenkins_job=~\"$jenkins_job\"}) / 60000",
          "instant": false,
          "legendFormat": "{{jenkins_job}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "left",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
